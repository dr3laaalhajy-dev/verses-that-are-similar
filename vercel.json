{
  "crons": [
    {
      "path": "/api/notifications/cron-friday",
      "schedule": "0 6 * * 5"
    },
    {
      "path": "/api/notifications/cron-wird",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/adhkar?type=morning",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/adhkar?type=evening",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/testers", "destination": "/api/settings?target=testers" },
    { "source": "/api/version-control", "destination": "/api/settings?target=version-control" },
    { "source": "/api/challenges/:id", "destination": "/api/challenges?id=:id" },
    { "source": "/api/notifications/send", "destination": "/api/notifications?action=send" },
    { "source": "/api/notifications/register-token", "destination": "/api/notifications?action=register-token" },
    { "source": "/api/notifications/cron-friday", "destination": "/api/cron?job=friday" },
    { "source": "/api/notifications/cron-wird", "destination": "/api/cron?job=wird" },
    { "source": "/api/cron/adhkar", "destination": "/api/cron?job=adhkar" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/privacy.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/data-deletion", "destination": "/delete-account.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ]
}
