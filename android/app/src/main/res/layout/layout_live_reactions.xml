<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/reactionsAnimationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/reactionsBarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btnReactionClap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:text="👏" />

        <TextView
            android:id="@+id/btnReactionMindblown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:text="🤯" />

        <TextView
            android:id="@+id/btnReactionParty"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:text="🎉" />

        <TextView
            android:id="@+id/btnReactionLaugh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:text="😂" />

        <TextView
            android:id="@+id/btnReactionClock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:text="⏱️" />
    </LinearLayout>
</merge>
