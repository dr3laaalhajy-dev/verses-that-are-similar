generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int     @id @default(autoincrement())
  username       String  @unique
  password       String
  isSuperAdmin   Boolean @default(false)
  role           String  @default("ADMIN")
  name           String?
  canManageUsers Boolean @default(false)
}

model AdminCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  role      String   @default("ADMIN")
}

model Challenge {
  id          Int      @id @default(autoincrement())
  keyword     String   @unique
  verses      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String   @default("")
  level       String   @default("")
  audioUrl    String?
  correctText String?
  options     Json?
  type        String   @default("STANDARD")
  juz         Int?
  surah       String?
}

model Player {
  id                     Int          @id @default(autoincrement())
  deviceId               String?      @unique
  name                   String
  points                 Int          @default(0)
  cups                   Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  completedChallengeIds  Json         @default("[]")
  generalCompleted       Boolean      @default(false)
  quranCompleted         Boolean      @default(false)
  seerahCompleted        Boolean      @default(false)
  password               String?      @default("1234")
  username               String?      @unique
  usernameChangedAt      DateTime?
  activeFrame            String?
  isBlocked              Boolean      @default(false)
  equippedNameColor      String?
  ownedCosmetics         Json         @default("[]")
  powerUps               Json         @default("{\"deleteTwo\": 3, \"freezeTime\": 3}")
  streak                 Int          @default(0)
  uniquePlayerId         String?      @unique
  rooms1                 Room[]       @relation("Player1Rooms")
  rooms2                 Room[]       @relation("Player2Rooms")
  wonRooms               Room[]       @relation("WinnerRooms")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  addressee   Player           @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   Player           @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

model Room {
  id                   String   @id @default(uuid())
  code                 String   @unique
  player1Id            Int
  player2Id            Int?
  player1Progress      Int      @default(0)
  player2Progress      Int      @default(0)
  status               String   @default("WAITING")
  winnerId             Int?
  challengeIds         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  questionCount        Int      @default(5)
  surahFilters         Json     @default("[]")
  categoryFilter       String   @default("")
  gameMode             String   @default("STANDARD")
  maxPlayers           Int      @default(2)
  playersProgress      Json     @default("{}")
  timePerQuestion      Int      @default(20)
  name                 String?  @default("")
  isPrivate            Boolean  @default(false)
  password             String?
  currentQuestionIndex Int      @default(0)
  questionStartTime    Float?   @default(0)
  currentAnswers       Json?    @default("{}")
  transitionMode       String   @default("SYNC")
  lastReaction         Json?    @default("{}")
  player1              Player   @relation("Player1Rooms", fields: [player1Id], references: [id])
  player2              Player?  @relation("Player2Rooms", fields: [player2Id], references: [id])
  winner               Player?  @relation("WinnerRooms", fields: [winnerId], references: [id])
}

model SystemSetting {
  id                      Int      @id @default(1)
  hideAudioChallenge      Boolean  @default(false)
  hideCompletionChallenge Boolean  @default(false)
  hideSurahChallenge      Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  hideIslamicVideos       Boolean  @default(false)
  versionControl          Json?
}

model AppTester {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  status     String    @default("PENDING")
  updatedAt  DateTime? @updatedAt
}

model Reaction {
  id            String   @id @default(uuid())
  room_id       String
  reaction_type String
  emoji         String
  sender_id     String
  sender_name   String
  created_at    DateTime @default(now())

  @@index([room_id])
  @@map("reactions")
}

model WhoAmICategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  created_at  DateTime @default(now())

  @@map("who_am_i_categories")
}

model WhoAmIQuestion {
  id         String        @id @default(uuid())
  category   String        @default("الصحابة")
  hint_1     String
  hint_2     String
  answer     String
  created_at DateTime      @default(now())
  rounds     WhoAmIRound[]

  @@map("who_am_i_questions")
}

model WhoAmIRound {
  id          String             @id @default(uuid())
  room_id     String
  question_id String
  round_no    Int
  status      String             @default("active")
  started_at  DateTime           @default(now())
  answers     WhoAmIAnswer[]
  question    WhoAmIQuestion     @relation(fields: [question_id], references: [id])
  submissions WhoAmISubmission[]

  @@unique([room_id, round_no])
  @@map("who_am_i_rounds")
}

model WhoAmIAnswer {
  id          String      @id @default(uuid())
  room_id     String
  round_id    String
  user_id     String
  player_name String
  answer_text String
  phase       Int
  is_correct  Boolean     @default(false)
  points      Int         @default(0)
  overridden  Boolean     @default(false)
  created_at  DateTime    @default(now())
  round       WhoAmIRound @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@unique([round_id, user_id])
  @@map("who_am_i_answers")
}

model WhoAmISubmission {
  round_id    String
  room_id     String
  user_id     String
  player_name String
  created_at  DateTime    @default(now())
  round       WhoAmIRound @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@id([round_id, user_id])
  @@map("who_am_i_submissions")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  body        String
  sender_role String?  @default("FOUNDER")
  sender_name String?
  metadata    Json?    @default("{}")
  created_at  DateTime @default(now())
  target_url  String?
  updated_at  DateTime @default(now()) @updatedAt
  is_read     Boolean? @default(false)
  user_id     String?

  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(uuid())
  user_id    String?
  fcm_token  String   @unique
  platform   String?  @default("web")
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("device_tokens")
}

model UserWird {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  pages_per_day      Int      @default(4)
  current_page       Int      @default(1)
  notification_time  String   @default("08:00")
  is_active          Boolean  @default(true)
  last_notified_date String?
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@map("user_wird")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}


model UserAnswer {
  id          String   @id @default(uuid())
  user_id     String
  category    String
  question_id String?
  is_correct  Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id, category, is_correct])
  @@map("user_answers")
}
